{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vinoveil-backend",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "AUTH_BASE_URL": "https://api.vinoveil.com",
    "APP_ORIGINS": "https://vinoveil.com,https://www.vinoveil.com",
    "EMAIL_ENABLED": "false",
    "TRAFFIC_ENABLED": "false",
    "EMAIL_FROM": "noreply@notify.vinoveil.com",
    "CONTACT_TO_EMAIL": "emailmyconsultant@gmail.com"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "vinoveil-backend", "database_id": "7d3bc7cc-de17-4f72-abb3-6015fb0b9915", "migrations_dir": "migrations", "remote": false }],
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["noreply@notify.vinoveil.com"] }]
}
